# Supabase（主要資料庫）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google Sheets（若仍需使用，可保留）
# GOOGLE_SHEET_ID=xxx
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# 封存滿幾天後永久清除主檔（預設 30；需 CRON_SECRET，隨每日長期案排程執行）
# ARCHIVE_RETENTION_DAYS=30

# Resend 寄送任務指派通知
# RESEND_API_KEY=re_xxxx
# RESEND_FROM_EMAIL=SDH ERP <noreply@你的網域.com>

# 錄音室預約付款成功後，把要開的發票送進待審核（與 studio-booking 的 ERP_INVOICE_INGEST_SECRET 相同）
# BOOKING_INVOICE_INGEST_SECRET=請設一組隨機字串

# 光貿電子發票（測試與正式共用網址，用統編與 APP KEY 區分）
# AMEGO_INVOICE_BAN=12345678
# AMEGO_APP_KEY=your_amego_app_key
# AMEGO_API_BASE=https://invoice-api.amego.tw
# 預設 2026-11-01（台北）才開放開立／審核；提前測試可設 FORCE_OPEN=1，或改 LAUNCH 日期
# NEXT_PUBLIC_INVOICE_E_INVOICE_LAUNCH=2026-11-01
# NEXT_PUBLIC_INVOICE_E_INVOICE_FORCE_OPEN=1

# 正式網域（收款連結、郵件 deep link 固定用此網址）
# NEXT_PUBLIC_APP_URL=https://erp.sdh-corp.com

# 粉絲數爬取（截圖 + AI 辨識，支援 YouTube / Facebook / Instagram）
# GEMINI_API_KEY=AIzaSy...        # Google AI Studio 取得
# SCREENSHOT_ONE_ACCESS_KEY=xxxx   # 至 screenshotone.com 申請（約 100 張/月免費）
