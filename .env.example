# Supabase（主要資料庫）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google Sheets（若仍需使用，可保留）
# GOOGLE_SHEET_ID=xxx
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Resend 寄送任務指派通知
# RESEND_API_KEY=re_xxxx
# RESEND_FROM_EMAIL=SDH ERP <noreply@你的網域.com>

# 粉絲數爬取（截圖 + AI 辨識，支援 YouTube / Facebook / Instagram）
# GEMINI_API_KEY=AIzaSy...        # Google AI Studio 取得
# SCREENSHOT_ONE_ACCESS_KEY=xxxx   # 至 screenshotone.com 申請（約 100 張/月免費）
